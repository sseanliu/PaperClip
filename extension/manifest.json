{
  "manifest_version": 3,
  "name": "PaperClip",
  "version": "1.0.0",
  "description": "Your new tab page becomes a Zotero-style library of every academic paper you've ever opened. Auto-captures and enriches with metadata.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "nativeMessaging",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save tab to PaperClip",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
